---
import type { Publication } from '../data/site';

interface Props {
  publication: Publication;
}

const { publication } = Astro.props;

const tagColorClasses: Record<string, string> = {
  'LLM post-training': 'tag-violet',
  'Multi-turn RL': 'tag-amber',
  'Multimodal generation': 'tag-blue',
  GRPO: 'tag-violet',
  'Masked diffusion': 'tag-cyan',
  'Self-correction': 'tag-emerald',
  'LLM safety': 'tag-red',
  'Automated red teaming': 'tag-orange',
  'Adversarial ML': 'tag-rose',
  Fuzzing: 'tag-amber',
  'Reinforcement learning': 'tag-violet',
  'Decision transformers': 'tag-indigo',
  'Time series': 'tag-cyan',
  Transformers: 'tag-indigo',
  'Multimodal reasoning': 'tag-blue',
  'Domain generalization': 'tag-emerald',
  Optimization: 'tag-amber',
  Interpretability: 'tag-teal',
  'Graph learning': 'tag-blue',
  'Meta-learning': 'tag-indigo',
  'Task heterogeneity': 'tag-orange',
};
---

<article class="publication-card">
  {
    publication.image ? (
      <img
        class="paper-image"
        src={publication.image}
        alt={publication.imageAlt ?? `Figure for ${publication.title}`}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class:list={['paper-art', `tone-${publication.tone}`]} aria-hidden="true">
        {publication.art}
      </div>
    )
  }
  <div class="paper-copy">
    <h3>
      {publication.title}
      <span class="publication-tags">
        {
          publication.tags.map((tag) => (
            <span class:list={['publication-tag', tagColorClasses[tag]]}>{tag}</span>
          ))
        }
      </span>
    </h3>
    <p class="paper-authors" set:html={publication.authors} />
    <p class="paper-venue">{publication.venue}</p>
    {
      publication.links.length > 0 && (
        <div class="paper-actions">
          {publication.links.map((link) => (
            <a
              class:list={['paper-action', { secondary: link.kind === 'secondary' }]}
              href={link.href}
              target="_blank"
              rel="noreferrer"
            >
              {link.label}
            </a>
          ))}
        </div>
      )
    }
    <p class="paper-summary">{publication.summary}</p>
  </div>
</article>
